set udg_CriticalStrikeRoll=(udg_CriticalStrikeRoll+20)if(Trig_GlobalCriticalStrikes_Func010Func002Func004C())thenset udg_CriticalStrikeDamage=(udg_CriticalStrikeDamage+.5)else
set udg_CriticalStrikeDamage=(udg_CriticalStrikeDamage+1.)endifendifendifif(Trig_GlobalCriticalStrikes_Func012C())thenif(Trig_GlobalCriticalStrikes_Func012Func002C())then
set udg_CriticalStrikeRoll=(udg_CriticalStrikeRoll+25)else
if(Trig_GlobalCriticalStrikes_Func012Func002Func002C())thenset udg_CriticalStrikeRoll=(udg_CriticalStrikeRoll+$A)else
set udg_CriticalStrikeRoll=(udg_CriticalStrikeRoll+20)endifendifendifif(Trig_GlobalCriticalStrikes_Func014C())thenset udg_CriticalStrikeRoll=(udg_CriticalStrikeRoll+$F)endifif(Trig_GlobalCriticalStrikes_Func016C())thenset udg_CriticalStrikeRoll=(udg_CriticalStrikeRoll+45)endifif(Trig_GlobalCriticalStrikes_Func018C())thenset udg_CriticalStrikeRoll=(udg_CriticalStrikeRoll+$A)endifif(Trig_GlobalCriticalStrikes_Func020C())thenset udg_CriticalStrikeRoll=(udg_CriticalStrikeRoll+25)endifif(Trig_GlobalCriticalStrikes_Func022C())thenset udg_CriticalStrikeRoll=(udg_CriticalStrikeRoll+udg_Abil_FortuneAura)
endifif(Trig_GlobalCriticalStrikes_Func024C())thenset udg_CriticalStrikeDamage=(udg_CriticalStrikeDamage+.3)endifif(Trig_GlobalCriticalStrikes_Func026C())thenset udg_CriticalStrikeRoll=(udg_CriticalStrikeRoll+$A)endifif(Trig_GlobalCriticalStrikes_Func028C())thenset udg_CriticalStrikeRoll=(udg_CriticalStrikeRoll+3)endifif(Trig_GlobalCriticalStrikes_Func030C())thenset udg_CriticalStrikeRoll=(udg_CriticalStrikeRoll+5)endifif(Trig_GlobalCriticalStrikes_Func032C())thenset udg_CriticalStrikeRoll=(udg_CriticalStrikeRoll+'d')endifif(Trig_GlobalCriticalStrikes_Func034C())thenset udg_CriticalStrikeRoll='d'endifif(Trig_GlobalCriticalStrikes_Func036C())thenset udg_CriticalStrikeRoll=0
