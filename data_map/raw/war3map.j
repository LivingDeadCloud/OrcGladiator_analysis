if(Trig_Force_Choose_Func006Func002C())thenset udg_Upgrades_ScoreRequired=15.set udg_Upgrades_TotalEarned=0set udg_DifficultyString="Nightmare"
set udg_Nightmare=truecall DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,30,"TRIGSTR_331")call SetPlayerHandicapBJ(Player($A),125.)call SetPlayerHandicapBJ(Player($B),125.)call CreateNUnitsAtLocFacingLocBJ(1,'n01X',Player($B),GetRectCenter(gg_rct_SpawnNorth),GetUnitLoc(GetTriggerUnit()))
