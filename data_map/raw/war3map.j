if(Trig_Player_Commands_Func006Func002Func001C())thencall DisplayTimedTextToForce(GetForceOfPlayer(GetTriggerPlayer()),15.,(udg_STORAGE_PLAYERNAME[udg_TEMP_INT]+("'s hits tanked: "+R2S(udg_DamageTakenCount[udg_TEMP_INT]))))endifset udg_TEMP_INT=udg_TEMP_INT+1endloopendifif(Trig_Player_Commands_Func007C())thencall SetCameraFieldForPlayer(GetTriggerPlayer(),CAMERA_FIELD_ZOFFSET,900.,1.)endifif(Trig_Player_Commands_Func008C())thenif(Trig_Player_Commands_Func008Func001C())thencall DisplayTimedTextToForce(GetForceOfPlayer(GetTriggerPlayer()),15.,("Score Required: "+R2SW(udg_Upgrades_ScoreRequired,2,2)))
call DisplayTimedTextToForce(GetForceOfPlayer(GetTriggerPlayer()),15.,("Score Accumulated: "+R2SW(udg_Upgrades_ScoreEarned,2,2)))call DisplayTimedTextToForce(GetForceOfPlayer(GetTriggerPlayer()),15.,"Victory or Enchant = +1.0")call DisplayTimedTextToForce(GetForceOfPlayer(GetTriggerPlayer()),15.,"A+ = 0.5, A = 0.3, B = 0.1")
else
call DisplayTimedTextToForce(GetForceOfPlayer(GetTriggerPlayer()),15.,"Cannot earn Upgrades; cap reached.")endifendifif(Trig_Player_Commands_Func009C())thenset udg_TEMP_INT=1loop
