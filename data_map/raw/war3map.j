exitwhen bj_forLoopAIndex>bj_forLoopAIndexEndif(Trig_Run_Reward_Func006Func001C())thenset udg_GoldReward=((udg_CurrentWave-1)*$A)set udg_LeaderGoldReward=(2*(udg_CurrentWave-1))
call DisplayTimedTextToForce(GetForceOfPlayer(Player(-1+(bj_forLoopAIndex))),20.,("|cffffcc00Your victory earnings that round|r: "+(I2S(udg_GoldReward)+(" gold ("+("+"+(I2S(udg_LeaderGoldReward)+" random gold)"))))))
call AdjustPlayerStateBJ(udg_GoldReward,Player(-1+(bj_forLoopAIndex)),PLAYER_STATE_RESOURCE_GOLD)call AdjustPlayerStateBJ(udg_LeaderGoldReward,Player(-1+(bj_forLoopAIndex)),PLAYER_STATE_RESOURCE_GOLD)else
if(Trig_Run_Reward_Func006Func001Func002C())then
set udg_GoldReward=((udg_CurrentWave-1)*$A)call DisplayTimedTextToForce(GetForceOfPlayer(Player(-1+(bj_forLoopAIndex))),20.,("|cffffcc00Your victory earnings that round|r: "+(I2S(udg_GoldReward)+" gold")))call AdjustPlayerStateBJ(udg_GoldReward,Player(-1+(bj_forLoopAIndex)),PLAYER_STATE_RESOURCE_GOLD)endifendifset bj_forLoopAIndex=bj_forLoopAIndex+1endloopcall ConditionalTriggerExecute(gg_trg_Get_MVP_Current_Round)
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,5.," ")
call TriggerSleepAction(3.)if(Trig_Run_Reward_Func011C())thenif(Trig_Run_Reward_Func011Func001C())thencall DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,15.,"|c00ff6600You survived...|r")set udg_Upgrades_ScoreEarned=(udg_Upgrades_ScoreEarned+.5)set udg_GradeGoldBonus=R2I((I2R(udg_GoldReward)*1))set udg_WaveGrade="A+"set udg_AccumulatedGrade=0else
if(Trig_Run_Reward_Func011Func001Func001C())then
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,15.,"|c00ff6600You survived...|r")set udg_GradeGoldBonus=R2I((I2R(udg_GoldReward)*.5))
set udg_WaveGrade="C"set udg_AccumulatedGrade=0else
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,15.,"|c00ff6600You survived...|r")set udg_GradeGoldBonus=R2I((I2R(udg_GoldReward)*.0))
set udg_WaveGrade="G"set udg_AccumulatedGrade=0endifendifelse
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,15.,("It took you "+(I2S(udg_WaveTimeElapsed)+" seconds to clear the wave.")))
if(Trig_Run_Reward_Func011Func003C())thenset udg_Upgrades_ScoreEarned=(udg_Upgrades_ScoreEarned+.5)set udg_GradeGoldBonus=R2I((I2R(udg_GoldReward)*1))set udg_WaveGrade="A+"else
if(Trig_Run_Reward_Func011Func003Func003C())then
set udg_Upgrades_ScoreEarned=(udg_Upgrades_ScoreEarned+.3)set udg_GradeGoldBonus=R2I((I2R(udg_GoldReward)*.75))set udg_WaveGrade="A"else
if(Trig_Run_Reward_Func011Func003Func003Func003C())thenset udg_Upgrades_ScoreEarned=(udg_Upgrades_ScoreEarned+.1)set udg_GradeGoldBonus=R2I((I2R(udg_GoldReward)*.5))
set udg_WaveGrade="B"else
if(Trig_Run_Reward_Func011Func003Func003Func003Func003C())thenset udg_GradeGoldBonus=R2I((I2R(udg_GoldReward)*.4))
set udg_WaveGrade="C"else
if(Trig_Run_Reward_Func011Func003Func003Func003Func003Func002C())thenset udg_GradeGoldBonus=R2I((I2R(udg_GoldReward)*.3))
set udg_WaveGrade="D"else
if(Trig_Run_Reward_Func011Func003Func003Func003Func003Func002Func002C())then
set udg_GradeGoldBonus=R2I((I2R(udg_GoldReward)*.2))
set udg_WaveGrade="E"else
if(Trig_Run_Reward_Func011Func003Func003Func003Func003Func002Func002Func002C())thenset udg_GradeGoldBonus=R2I((I2R(udg_GoldReward)*.1))
set udg_WaveGrade="F"else
if(Trig_Run_Reward_Func011Func003Func003Func003Func003Func002Func002Func002Func002C())thenset udg_GradeGoldBonus=R2I((I2R(udg_GoldReward)*.0))
set udg_WaveGrade="G"set udg_WaveTimeElapsed=281endifendifendifendifendifendifendifendifset udg_AccumulatedGrade=(udg_AccumulatedGrade+udg_WaveTimeElapsed)call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,15.,("|cffffcc00Grade|r: "+(udg_WaveGrade+(" (+"+(I2S(udg_GradeGoldBonus)+" gold)")))))endifset udg_TempInteger=1loop
exitwhen udg_TempInteger>$Aif(Trig_Run_Reward_Func013Func001C())thencall AdjustPlayerStateBJ(udg_GradeGoldBonus,Player(-1+(udg_TempInteger)),PLAYER_STATE_RESOURCE_GOLD)
endifset udg_TempInteger=udg_TempInteger+1endloopcall DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,15.," ")call TriggerExecute(gg_trg_Repay_Loans)call TriggerSleepAction(6.)call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,5.,"Choose a stat reward in:")
call TriggerSleepAction(1.)call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,5.,"3..")
call TriggerSleepAction(1.)call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,5.,"2..")
call TriggerSleepAction(1.)call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,5.,"1..")
call TriggerSleepAction(1.)call ConditionalTriggerExecute(gg_trg_Revive_Players)call ConditionalTriggerExecute(gg_trg_RewardCreateDialog)call TriggerSleepAction(10.)
call TriggerExecute(gg_trg_SpawnEnchant)
call TriggerSleepAction(5.)if(Trig_Run_Reward_Func031C())thencall TriggerExecute(gg_trg_Weapon_Upgrade_Initiate)endifendfunctionfunction InitTrig_Run_Reward takes nothing returns nothingset gg_trg_Run_Reward=CreateTrigger()call TriggerAddAction(gg_trg_Run_Reward,function Trig_Run_Reward_Actions)endfunctionfunction Trig_Minions_Defeated_Func001C takes nothing returns booleanreturn(GetPlayerState(Player($A),PLAYER_STATE_RESOURCE_FOOD_USED)==0)and(GetPlayerState(Player($B),PLAYER_STATE_RESOURCE_FOOD_USED)==0)endfunctionfunction Trig_Minions_Defeated_Conditions takes nothing returns booleanreturn(Trig_Minions_Defeated_Func001C())and(udg_CurrentWave==20)
endfunctionfunction Trig_Minions_Defeated_Actions takes nothing returns nothing
call DisableTrigger(gg_trg_Bonecarver_Periodic)call DisableTrigger(GetTriggeringTrigger())call StopMusic(true)
call PlaySoundBJ(gg_snd_Tension)
call TriggerSleepAction(2.)call ConditionalTriggerExecute(gg_trg_Revive_Players)call ConditionalTriggerExecute(gg_trg_Dispel_Players)call TriggerSleepAction(2.)set bj_forLoopAIndex=1set bj_forLoopAIndexEnd=$Aloop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEndcall CinematicModeBJ(true,bj_FORCE_ALL_PLAYERS)call PanCameraToTimedLocForPlayer(Player(-1+(bj_forLoopAIndex)),GetRectCenter(gg_rct_Boss_Spawn),2.)
set bj_forLoopAIndex=bj_forLoopAIndex+1endloopcall TriggerSleepAction(2.)call SetPlayerTechResearchedSwap('R010',udg_PLAYINGPLAYERS,Player($B))set udg_TEMP_POINT=GetRectCenter(gg_rct_Boss_Spawn)call CreateNUnitsAtLoc(1,'H00I',Player($B),udg_TEMP_POINT,270.)call AddSpecialEffectTargetUnitBJ("origin",bj_lastCreatedUnit,"Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTarget.mdl")call DestroyEffect(bj_lastCreatedEffect)
call SetUnitAbilityLevelSwapped('A06N',bj_lastCreatedUnit,udg_PLAYINGPLAYERS)call SetUnitAbilityLevelSwapped('A06L',bj_lastCreatedUnit,udg_PLAYINGPLAYERS)call SetUnitAbilityLevelSwapped('A06M',bj_lastCreatedUnit,udg_PLAYINGPLAYERS)set udg_Boss=bj_lastCreatedUnitcall PauseUnit(udg_Boss,true)call SetUnitInvulnerable(udg_Boss,true)call SetHeroLevelBJ(bj_lastCreatedUnit,30,false)
set bj_forLoopAIndex=1set bj_forLoopAIndexEnd=$Aloop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEndcall RotateCameraAroundLocBJ(360.,udg_TEMP_POINT,Player(-1+(bj_forLoopAIndex)),10.)set bj_forLoopAIndex=bj_forLoopAIndex+1endloopcall RemoveLocation(udg_TEMP_POINT)call TriggerSleepAction(10.)
call CinematicModeBJ(false,bj_FORCE_ALL_PLAYERS)
set bj_forLoopAIndex=1set bj_forLoopAIndexEnd=$Aloop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEndcall ResetToGameCameraForPlayer(Player(-1+(bj_forLoopAIndex)),0)
call SetCameraFieldForPlayer(Player(-1+(bj_forLoopAIndex)),CAMERA_FIELD_ZOFFSET,900.,1.)
set bj_forLoopAIndex=bj_forLoopAIndex+1endloopcall EnableTrigger(gg_trg_LordOfTheArenaAI)call EnableTrigger(gg_trg_Boss20PunishmentTrigger)call EnableTrigger(gg_trg_Boss20Punishment)call EnableTrigger(gg_trg_Boss20Phase2Trigger)call EnableTrigger(gg_trg_Boss20Phase2CheatDeath)call PauseUnit(udg_Boss,false)call SetUnitInvulnerable(udg_Boss,false)
call PlaySoundBJ(gg_snd_PursuitTheme)call TriggerExecute(gg_trg_Bonecarver_Periodic)call EnableTrigger(gg_trg_Bonecarver_Periodic)endfunctionfunction InitTrig_Minions_Defeated takes nothing returns nothing
