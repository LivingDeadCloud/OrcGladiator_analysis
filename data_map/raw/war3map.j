set udg_CriticalStrikeDamage=2.if(Trig_GlobalCriticalStrikes_Func010C())thenif(Trig_GlobalCriticalStrikes_Func010Func002C())then
set udg_CriticalStrikeRoll=(udg_CriticalStrikeRoll+$A)if(Trig_GlobalCriticalStrikes_Func010Func002Func008C())thenset udg_CriticalStrikeDamage=(udg_CriticalStrikeDamage+.5)else
