set udg_Upgrades_ScoreRequired=15.set udg_Upgrades_TotalEarned=0set udg_DifficultyString="Normal"set udg_Nightmare=falsecall DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,30,"TRIGSTR_7428")
