set udg_heal_diff=udg_heal_amountendifif(Trig_Heal_Check_Loop_Func002Func009Func005Func007C())then
set udg_HealEvent=.5
set udg_HealEvent=.0
endifendifendifset udg_heal_integer=udg_heal_indexRef[udg_heal_integer]
set udg_heal_integer=udg_heal_integer+1endloopendfunctionfunction InitTrig_Heal_Check_Loop takes nothing returns nothingset gg_trg_Heal_Check_Loop=CreateTrigger()call DisableTrigger(gg_trg_Heal_Check_Loop)call TriggerRegisterTimerExpireEvent(gg_trg_Heal_Check_Loop,udg_heal_timer)call TriggerAddAction(gg_trg_Heal_Check_Loop,function Trig_Heal_Check_Loop_Actions)endfunctionfunction Trig_Heal_Add_Unit_Conditions takes nothing returns boolean
