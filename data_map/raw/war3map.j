if(Trig_Create_Corpse_Func001Func013C())then
set udg_ReviveDisabled=false
call SetUnitVertexColorBJ(bj_lastCreatedUnit,'d',.0,.0,0)call UnitAddAbility(bj_lastCreatedUnit,'A0I4')call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,30,("|cffffcc00Gladiators Alive|r: "+I2S(udg_LIVINGPLAYERS)))else
if(Trig_Create_Corpse_Func001Func013Func003C())thencall AddSpecialEffectTargetUnitBJ("origin",bj_lastCreatedUnit,"Abilities\\Spells\\Items\\AIso\\AIsoTarget.mdl")call DestroyEffect(bj_lastCreatedEffect)
call SaveRealBJ(4.5,1,GetHandleIdBJ(bj_lastCreatedUnit),udg_CorpseHash)call GroupAddUnit(udg_SoulstoneGroup,bj_lastCreatedUnit)
call DisplayTimedTextToForce(GetForceOfPlayer(Player(-1+((1+GetPlayerId(GetOwningPlayer(GetTriggerUnit())))))),15.,"|c00ff0000Your Soulstone glows brightly...|r")call EnableTrigger(gg_trg_Soulstones_Draughts_Sap)else
if(Trig_Create_Corpse_Func001Func013Func003Func002C())thencall RemoveItem(GetItemOfTypeFromUnitBJ(GetDyingUnit(),'I05R'))call SaveRealBJ(6.,1,GetHandleIdBJ(bj_lastCreatedUnit),udg_CorpseHash)call GroupAddUnit(udg_SoulstoneGroup,bj_lastCreatedUnit)
call DisplayTimedTextToForce(GetForceOfPlayer(Player(-1+((1+GetPlayerId(GetOwningPlayer(GetTriggerUnit())))))),15.,"|c00ff0000As you fall to the ground, you imbibe your Revival Drought...|r")call EnableTrigger(gg_trg_Soulstones_Draughts_Sap)else
if(Trig_Create_Corpse_Func001Func013Func003Func002Func002C())thencall SaveRealBJ(4.,1,GetHandleIdBJ(bj_lastCreatedUnit),udg_CorpseHash)call GroupAddUnit(udg_SoulstoneGroup,bj_lastCreatedUnit)
call DisplayTimedTextToForce(GetForceOfPlayer(Player(-1+((1+GetPlayerId(GetOwningPlayer(GetTriggerUnit())))))),15.,"|c00ff0000Life energy from your Ancient's Sap rushes into you...|r")call EnableTrigger(gg_trg_Soulstones_Draughts_Sap)else
call DisplayTimedTextToForce(GetForceOfPlayer(Player(-1+((1+GetPlayerId(GetOwningPlayer(GetTriggerUnit())))))),15.,"|c00ff0000Your Gladiator is unconscious. You can be revived by other Gladiators, or when the round ends.|r")call RemoveItem(GetItemOfTypeFromUnitBJ(GetDyingUnit(),'I056'))call RemoveItem(GetItemOfTypeFromUnitBJ(GetDyingUnit(),'I058'))call RemoveItem(GetItemOfTypeFromUnitBJ(GetDyingUnit(),'I057'))call ConditionalTriggerExecute(gg_trg_Living_Players)call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,30,("|cffffcc00Gladiators Alive|r: "+I2S(udg_LIVINGPLAYERS)))if(Trig_Create_Corpse_Func001Func013Func003Func002Func002Func010C())then
call EnableTrigger(gg_trg_Check_Defeat)endifendifendifendifendifset bj_forLoopAIndex=1set bj_forLoopAIndexEnd=$Aloop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEndif(Trig_Create_Corpse_Func001Func015Func001C())thenif(Trig_Create_Corpse_Func001Func015Func001Func002C())thencall SaveRealBJ(10.,0,GetHandleIdBJ(GetOwningPlayer(udg_PlayerHero[bj_forLoopAIndex])),udg_Abil_AvengingRageHash)call UnitAddAbility(udg_PlayerHero[bj_forLoopAIndex],'A0FO')
call GroupAddUnit(udg_Abil_AvengingRageGroup,udg_PlayerHero[bj_forLoopAIndex])call AddSpecialEffectTargetUnitBJ("origin",udg_PlayerHero[bj_forLoopAIndex],"Abilities\\Spells\\NightElf\\BattleRoar\\RoarCaster.mdl")call DestroyEffect(bj_lastCreatedEffect)
if(Trig_Create_Corpse_Func001Func015Func001Func002Func023001())thencall EnableTrigger(gg_trg_KatanaAvengingRagePeriodic)endifelse
call SaveRealBJ(15.,0,GetHandleIdBJ(GetOwningPlayer(udg_PlayerHero[bj_forLoopAIndex])),udg_Abil_AvengingRageHash)set udg_NextHealSource=udg_PlayerHero[bj_forLoopAIndex]set udg_NextHealTarget=udg_PlayerHero[bj_forLoopAIndex]set udg_NextHealAmount=(GetUnitStateSwap(UNIT_STATE_MAX_LIFE,udg_PlayerHero[bj_forLoopAIndex])*.25)call TriggerExecute(gg_trg_Heal_Unit)call UnitAddAbility(udg_PlayerHero[bj_forLoopAIndex],'A0FO')
