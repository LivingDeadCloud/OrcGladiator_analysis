exitwhen bj_forLoopAIndex>bj_forLoopAIndexEndset udg_AttributeStrength[bj_forLoopAIndex]=GetHeroStatBJ(0,udg_PlayerHero[bj_forLoopAIndex],true)set udg_AttributeIntelligence[bj_forLoopAIndex]=GetHeroStatBJ(2,udg_PlayerHero[bj_forLoopAIndex],true)set udg_AttributeAgility[bj_forLoopAIndex]=GetHeroStatBJ(1,udg_PlayerHero[bj_forLoopAIndex],true)set bj_forLoopAIndex=bj_forLoopAIndex+1endloopendfunctionfunction InitTrig_Detect_Attributes takes nothing returns nothingset gg_trg_Detect_Attributes=CreateTrigger()
