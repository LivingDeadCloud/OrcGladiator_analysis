if(Trig_Player_Commands_Func009Func001Func001C())thencall DisplayTimedTextToForce(GetForceOfPlayer(GetTriggerPlayer()),15.,(("Player "+(I2S(udg_TEMP_INT)+" = "))+udg_STORAGE_PLAYERNAME[udg_TEMP_INT]))endifset udg_TEMP_INT=udg_TEMP_INT+1endloopendifif(Trig_Player_Commands_Func010C())thenset udg_Borrow_Integer=(1+GetPlayerId(GetTriggerPlayer()))loop
exitwhen udg_Borrow_Integer>(1+GetPlayerId(GetTriggerPlayer()))set udg_Borrow_LoanInteger=1
loop
exitwhen udg_Borrow_LoanInteger>$Aset udg_Borrow_LoanAmount=LoadIntegerBJ(udg_Borrow_Integer,udg_Borrow_LoanInteger,udg_Borrow_Hash)set udg_Borrow_WealthCurrent=GetPlayerState(Player(-1+(udg_Borrow_Integer)),PLAYER_STATE_RESOURCE_GOLD)if(Trig_Player_Commands_Func010Func001Func001Func005C())then
call DisplayTimedTextToForce(GetForceOfPlayer(GetTriggerPlayer()),15.,("You owe "+(udg_STORAGE_PLAYERNAME[udg_Borrow_LoanInteger]+(" "+I2S(udg_Borrow_LoanAmount)))))endifset udg_Borrow_LoanInteger=udg_Borrow_LoanInteger+1endloopset udg_Borrow_Integer=udg_Borrow_Integer+1endloopendifif(Trig_Player_Commands_Func011C())thenset udg_Borrow_Integer=1
