call DisplayTimedTextToForce(GetForceOfPlayer(Player(-1+((1+GetPlayerId(GetOwningPlayer(udg_TalentHero)))))),10.,"|cffffcc00You can't learn talents whilst dead.|r")
else
call DisplayTimedTextToForce(GetForceOfPlayer(GetOwningPlayer(udg_TalentHero)),10.,"You have successfully applied a talent.")if(Trig_Scythe_Talent_Buy_Func003Func004C())then
if(Trig_Scythe_Talent_Buy_Func003Func004Func002C())thencall SetUnitAbilityLevelSwapped('A008',udg_TalentHero,3)
else
if(Trig_Scythe_Talent_Buy_Func003Func004Func002Func002C())thencall SetUnitAbilityLevelSwapped('A008',udg_TalentHero,4)
endifendifendifif(Trig_Scythe_Talent_Buy_Func003Func006C())then
set udg_TalentUpgradeAbility='A008'if(Trig_Scythe_Talent_Buy_Func003Func006Func004C())thencall SetUnitAbilityLevelSwapped(udg_TalentUpgradeAbility,udg_TalentHero,2)else
if(Trig_Scythe_Talent_Buy_Func003Func006Func004Func002C())thencall SetUnitAbilityLevelSwapped(udg_TalentUpgradeAbility,udg_TalentHero,4)endifendifset udg_TalentUpgradeAbility='A0FA'if(Trig_Scythe_Talent_Buy_Func003Func006Func007C())thencall SetUnitAbilityLevelSwapped(udg_TalentUpgradeAbility,udg_TalentHero,2)else
if(Trig_Scythe_Talent_Buy_Func003Func006Func007Func002C())thencall SetUnitAbilityLevelSwapped(udg_TalentUpgradeAbility,udg_TalentHero,4)endifendifendifif(Trig_Scythe_Talent_Buy_Func003Func008C())then
set udg_TalentUpgradeAbility='A0FA'call SetPlayerTechResearchedSwap('R00T',1,GetOwningPlayer(udg_TalentHero))if(Trig_Scythe_Talent_Buy_Func003Func008Func006C())thencall SetUnitAbilityLevelSwapped(udg_TalentUpgradeAbility,udg_TalentHero,3)else
if(Trig_Scythe_Talent_Buy_Func003Func008Func006Func002C())thencall SetUnitAbilityLevelSwapped(udg_TalentUpgradeAbility,udg_TalentHero,4)endifendifendifif(Trig_Scythe_Talent_Buy_Func003Func010C())then
if(Trig_Scythe_Talent_Buy_Func003Func010Func002C())thencall SetUnitAbilityLevelSwapped('A00B',udg_TalentHero,2)
endifendifif(Trig_Scythe_Talent_Buy_Func003Func012C())then
set udg_TalentUpgradeAbility='A02Q'if(Trig_Scythe_Talent_Buy_Func003Func012Func003C())thencall SetUnitAbilityLevelSwapped(udg_TalentUpgradeAbility,udg_TalentHero,2)else
call UnitAddAbility(udg_TalentHero,'A02S')call SetUnitAbilityLevelSwapped('A02R',udg_TalentHero,2)
endifendifif(Trig_Scythe_Talent_Buy_Func003Func014C())then
set udg_TalentUpgradeAbility='A02Q'if(Trig_Scythe_Talent_Buy_Func003Func014Func003C())thencall UnitRemoveAbility(udg_TalentHero,udg_TalentUpgradeAbility)call UnitAddAbility(udg_TalentHero,'A02R')else
call UnitRemoveAbility(udg_TalentHero,udg_TalentUpgradeAbility)call UnitAddAbility(udg_TalentHero,'A02R')call SetUnitAbilityLevelSwapped('A02R',udg_TalentHero,2)
call UnitAddAbility(udg_TalentHero,'A02S')endifendifif(Trig_Scythe_Talent_Buy_Func003Func016C())then
set udg_TalentUpgradeAbility='A00C'if(Trig_Scythe_Talent_Buy_Func003Func016Func003C())thencall SetUnitAbilityLevelSwapped(udg_TalentUpgradeAbility,udg_TalentHero,2)endifendifif(Trig_Scythe_Talent_Buy_Func003Func018C())then
call SetPlayerTechResearchedSwap('R000',1,GetOwningPlayer(GetTriggerUnit()))
endifif(Trig_Scythe_Talent_Buy_Func003Func020C())then
set udg_TalentUpgradeAbility='A00E'if(Trig_Scythe_Talent_Buy_Func003Func020Func003C())thencall UnitRemoveAbility(udg_TalentHero,udg_TalentUpgradeAbility)call UnitAddAbility(udg_TalentHero,'A088')else
call UnitRemoveAbility(udg_TalentHero,udg_TalentUpgradeAbility)call UnitAddAbility(udg_TalentHero,'A088')call SetUnitAbilityLevelSwapped('A088',udg_TalentHero,2)
endifendifif(Trig_Scythe_Talent_Buy_Func003Func022C())then
set udg_TalentUpgradeAbility='A00E'if(Trig_Scythe_Talent_Buy_Func003Func022Func003C())thencall SetUnitAbilityLevelSwapped('A00E',udg_TalentHero,2)
else
call SetUnitAbilityLevelSwapped('A088',udg_TalentHero,2)
endifendifif(Trig_Scythe_Talent_Buy_Func003Func024C())then
set udg_TalentUpgradeAbility='A00I'if(Trig_Scythe_Talent_Buy_Func003Func024Func003C())thencall SetUnitAbilityLevelSwapped(udg_TalentUpgradeAbility,udg_TalentHero,2)endifendifcall AddSpecialEffectTargetUnitBJ("origin",udg_TalentHero,"Abilities\\Spells\\Items\\AIem\\AIemTarget.mdl")call DestroyEffect(bj_lastCreatedEffect)
call RemoveItemFromStock(GetSellingUnit(),GetItemTypeId(GetSoldItem()))endifendfunctionfunction InitTrig_Scythe_Talent_Buy takes nothing returns nothingset gg_trg_Scythe_Talent_Buy=CreateTrigger()
