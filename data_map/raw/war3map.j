endfunctionfunction Trig_Living_Players_Func003Func001Func001C takes nothing returns booleanreturn(Trig_Living_Players_Func003Func001Func001Func001C())and(GetUnitTypeId(udg_PlayerHero[udg_Integer_LivingCheck])!=0)endfunctionfunction Trig_Living_Players_Func003Func001C takes nothing returns booleanreturn(Trig_Living_Players_Func003Func001Func001C())
