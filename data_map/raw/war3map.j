set udg_Borrow_Amount=(udg_Borrow_Amount-udg_Borrow_LoanAmount)if(Trig_Player_Commands_Func013Func025C())thencall DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,15.,(udg_STORAGE_PLAYERNAME[(1+GetPlayerId(GetTriggerPlayer()))]+(" loaned |c00ffff00"+(I2S(udg_Borrow_LoanAmount)+("|r gold. Remaining: |c00ffff00"+I2S(udg_Borrow_Amount))))))else
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,15.,(udg_STORAGE_PLAYERNAME[(1+GetPlayerId(GetTriggerPlayer()))]+(" loaned |c00ffff00"+(I2S(udg_Borrow_LoanAmount)+" |r gold."))))
set udg_Borrow_Timer=-1endifset udg_Borrow_LoanAmount=(LoadIntegerBJ((1+GetPlayerId(udg_Borrow_Current)),(1+GetPlayerId(udg_Borrow_Loaner)),udg_Borrow_Hash)+udg_Borrow_LoanAmount)call SaveIntegerBJ(udg_Borrow_LoanAmount,(1+GetPlayerId(udg_Borrow_Current)),(1+GetPlayerId(udg_Borrow_Loaner)),udg_Borrow_Hash)
endifif(Trig_Player_Commands_Func014C())thenset udg_AccumulatedGrade=(udg_AccumulatedGrade+300)call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,10.,"|c0033ff66 - Old Waves|r: Game will follow old monster sequence.")set udg_Modes_OldWaves=trueset udg_Modes_WaveModifier=1
call PlaySoundBJ(gg_snd_GoodJob)
endifif(Trig_Player_Commands_Func015C())thenset udg_AccumulatedGrade=(udg_AccumulatedGrade+300)call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,10.,"|c0033ff66 - Waves 2|r: Game will follow monster sequence 2")set udg_Modes_OldWaves=trueset udg_Modes_WaveModifier=2
call PlaySoundBJ(gg_snd_GoodJob)
endifif(Trig_Player_Commands_Func016C())thenset udg_AccumulatedGrade=(udg_AccumulatedGrade+300)call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,10.,"|c0033ff66 - Waves 3|r: Game will follow monster sequence 3")set udg_Modes_OldWaves=trueset udg_Modes_WaveModifier=3
