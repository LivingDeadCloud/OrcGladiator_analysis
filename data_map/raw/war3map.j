loop
exitwhen udg_MVPInteger>$Aset udg_DamageCountCurrentWave[udg_MVPInteger]=.0set udg_DamageTakenCurrentWave[udg_MVPInteger]=.0set udg_DamageBossCountCurrentWave[udg_MVPInteger]=.0set udg_HealCountCurrentWave[udg_MVPInteger]=.0set udg_MVPInteger=udg_MVPInteger+1endloopendfunctionfunction InitTrig_Get_MVP_Current_Round takes nothing returns nothingset gg_trg_Get_MVP_Current_Round=CreateTrigger()
