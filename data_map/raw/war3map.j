set udg_Upgrades_TotalCap=1else
if(Trig_Force_Choose_Func009Func001C())thenset udg_Upgrades_TotalCap=2else
if(Trig_Force_Choose_Func009Func001Func001C())thenset udg_Upgrades_TotalCap=3else
if(Trig_Force_Choose_Func009Func001Func001Func001C())thenset udg_Upgrades_TotalCap=4else
set udg_Upgrades_TotalCap=5endifendifendifendifcall TriggerSleepAction(2.)call EnableTrigger(gg_trg_Repick)call ConditionalTriggerExecute(gg_trg_Open_Gates)call PlaySoundBJ(gg_snd_JailDoorsOPen)set udg_CountdownTimerInteger=50
call TriggerSleepAction(50.)
call ConditionalTriggerExecute(gg_trg_Force_Random)set udg_CurrentWave=1call ConditionalTriggerExecute(gg_trg_Start_Game)endfunctionfunction InitTrig_Force_Choose takes nothing returns nothing
