endfunctionfunction InitTrig_Prevent_Spawn_Camp takes nothing returns nothingset gg_trg_Prevent_Spawn_Camp=CreateTrigger()call TriggerRegisterEnterRectSimple(gg_trg_Prevent_Spawn_Camp,gg_rct_GladiatorBlockEast)
