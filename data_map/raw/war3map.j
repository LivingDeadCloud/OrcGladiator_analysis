return(IsUnitType(GetTriggerUnit(),UNIT_TYPE_HERO)==false)!=null
endfunctionfunction Trig_Clear_Corpses_Actions takes nothing returns nothingcall TriggerSleepAction(15.)
call RemoveUnit(GetTriggerUnit())endfunctionfunction InitTrig_Clear_Corpses takes nothing returns nothingset gg_trg_Clear_Corpses=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_Clear_Corpses,EVENT_PLAYER_UNIT_DEATH)
call TriggerAddCondition(gg_trg_Clear_Corpses,Condition(function Trig_Clear_Corpses_Conditions))
call TriggerAddAction(gg_trg_Clear_Corpses,function Trig_Clear_Corpses_Actions)endfunctionfunction Trig_Set_Hints_Actions takes nothing returns nothingset udg_Hints[1]="Whilst dead, you will earn roughly 50% less EXP. Stay alive if you can!"set udg_Hints[2]="Summons are powerful. Not only do they deal damage, they also take damage heroes would normally take."
set udg_Hints[3]="Skills are automatically acquired as you level."set udg_Hints[4]="You get full boss EXP if you are dead."set udg_Hints[5]="Shamans have powerful offensive and supportive spells, but they are squishy. Protect them!"set udg_Hints[6]="Shamans with the Earth talent can tank very well when they proc Earth Shield."
set udg_Hints[7]="Talents are a way to upgrade your spells so that they are more powerful, or more useful."set udg_Hints[8]="Mana Tide (Claws) is a powerful group cooldown that restores mana to all nearby friendlies. Use it when the group is low on mana."
set udg_Hints[$B]="Vampiric Aura (Double Blade) is a useful aura. It will let your frontline fighters live for longer."set udg_Hints[$B]="Fire Storm (Double Blade) does a lot of area damage over time, but its quite expensive. Use it wisely!"set udg_Hints[$C]="Conjure Soulstone (Double Blade) lets your frontliners have the ability to auto-resurrect if they die. Don't be shy to ask for one!"set udg_Hints[$D]="Terror (Double Blade) is a powerful debuff ability that significantly cuts the damage of nearby enemies temporarily. Use it as much as possible in bigger games."
set udg_Hints[$E]="Demonic Circle (Double Blade) is a simple, low-cooldown ultimate that does reasonable damage, but it requires skill to get the most damage out of it."set udg_Hints[$F]="Demon Skin (Double Blade) allows the caster to tank on demand, and can be cast repeatedly, but requires mana for consant use."set udg_Hints[16]="Trying to escape the arena will get you teleported and stunned."set udg_Hints[17]="Enemies have a 6% chance to drop gold. It's only considered a \"bonus\", so don't go crazy for it!"endfunctionfunction InitTrig_Set_Hints takes nothing returns nothingset gg_trg_Set_Hints=CreateTrigger()
call TriggerAddAction(gg_trg_Set_Hints,function Trig_Set_Hints_Actions)endfunctionfunction Trig_Item_Cleanup_Func001Func010Func001C takes nothing returns booleanreturn(GetWidgetLife(GetEnumItem())==.0)
endfunctionfunction Trig_Item_Cleanup_Func001Func010A takes nothing returns nothing
if(Trig_Item_Cleanup_Func001Func010Func001C())thenset udg_ItemsToClean=(udg_ItemsToClean+1)set udg_CleanedItem[udg_ItemsToClean]=GetEnumItem()endifendfunctionfunction Trig_Item_Cleanup_Func001Func011C takes nothing returns boolean
return(udg_ItemsToClean>=0)endfunctionfunction Trig_Item_Cleanup_Func001C takes nothing returns booleanreturn(udg_ItemCleanupFlag)endfunctionfunction Trig_Item_Cleanup_Actions takes nothing returns nothing
if(Trig_Item_Cleanup_Func001C())then
set udg_ItemCleanupFlag=falseset udg_Loop=0loop
exitwhen udg_Loop>udg_ItemsToCleancall SetWidgetLife(udg_CleanedItem[udg_Loop],1.)
call RemoveItem(udg_CleanedItem[udg_Loop])set udg_CleanedItem[udg_Loop]=nullset udg_Loop=udg_Loop+1endloopelse
set udg_ItemsToClean=-1call EnumItemsInRectBJ(bj_mapInitialPlayableArea,function Trig_Item_Cleanup_Func001Func010A)
if(Trig_Item_Cleanup_Func001Func011C())thencall StartTimerBJ(udg_ItemCleanupTimer,false,1.5)set udg_ItemCleanupFlag=true
endifendifendfunctionfunction InitTrig_Item_Cleanup takes nothing returns nothing
