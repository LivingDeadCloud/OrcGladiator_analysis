set udg_heal_integer=0loop
exitwhen udg_heal_integer>udg_heal_exitwhenset udg_heal_integer=udg_heal_indices[udg_heal_integer]set udg_heal_target=udg_UDexUnits[udg_heal_integer]set udg_heal_life=GetUnitStateSwap(UNIT_STATE_LIFE,udg_heal_target)set udg_heal_diff=(udg_heal_life-udg_heal_lastLife[udg_heal_integer])set udg_heal_lastLife[udg_heal_integer]=udg_heal_lifeset udg_heal_amount=(udg_heal_diff-RMaxBJ(.0,udg_heal_regen[udg_heal_integer]))if(Trig_Heal_Check_Loop_Func002Func009C())thenset udg_HealEvent=1.
set udg_HealEvent=.0
else
set udg_heal_regen[udg_heal_integer]=((udg_heal_regen[udg_heal_integer]+udg_heal_diff)*.5)set udg_regen_buildup[udg_heal_integer]=(udg_regen_buildup[udg_heal_integer]+udg_heal_diff)set udg_regen_timeleft[udg_heal_integer]=(udg_regen_timeleft[udg_heal_integer]-udg_HEAL_CHECK_INTERVAL)if(Trig_Heal_Check_Loop_Func002Func009Func005C())thenset udg_regen_timeleft[udg_heal_integer]=udg_REGEN_EVENT_INTERVALset udg_heal_amount=udg_regen_buildup[udg_heal_integer]set udg_regen_buildup[udg_heal_integer]=.0if(Trig_Heal_Check_Loop_Func002Func009Func005Func006C())then
