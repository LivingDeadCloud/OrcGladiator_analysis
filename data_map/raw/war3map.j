call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,30,udg_SpawnString[1])
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,30,udg_SpawnString[2])
set udg_EXP_Per_Kill=(800/((udg_SpawnAmount*3)*udg_PLAYINGPLAYERS))set udg_SpawnPerPlayer=1
